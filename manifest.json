{
  "manifest_version": 3,
  "name": "CopyMe - Quick Link Clipboard",
  "version": "1.0.0",
  "description": "Save and organize your favorite links, snippets, and URLs. Copy to clipboard with a single click.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Open CopyMe"
  },
  "permissions": [
    "storage",
    "activeTab",
    "clipboardWrite"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Open CopyMe Popup"
    }
  }
}